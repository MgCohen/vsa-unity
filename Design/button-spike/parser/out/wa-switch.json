    }
  ],
  "anatomy": [
    {
      "tag": "label",
      "attrs": {
        "part": "base switch"
      },
      "children": [
        {
          "tag": "input",
          "attrs": {
            "class": "input",
            "type": "checkbox",
            "title": "${this.title}",
            "name": "${ifDefined(this.name)}",
            "value": "${ifDefined(this.value)}",
            ".checked": "${ifDefined(checkedProperty)}",
            "?checked": "${checkedAttribute}",
            "?disabled": "${this.disabled}",
            "?required": "${this.required}",
            "role": "switch",
            "aria-checked": "${this.checked ? \"true\" : \"false\"}",
            "aria-describedby": "hint",
            "@click": "${this.handleClick}",
            "@keydown": "${this.handleKeyDown}"
          }
        },
        {
          "tag": "span",
          "attrs": {
            "part": "control",
            "class": "switch"
          },
          "children": [
            {
              "tag": "span",
              "attrs": {
                "part": "thumb",
                "class": "thumb"
              }
            }
          ]
        },
        {
          "tag": "slot",
          "attrs": {
            "part": "label",
            "class": "label"
          }
        }
      ],
      "classMap": [
        {
          "name": "checked",
          "when": "this.checked"
        },
        {
          "name": "disabled",
          "when": "this.disabled"
        }
      ]
    },
    {
      "tag": "slot",
      "attrs": {
        "id": "hint",
        "name": "hint",
        "part": "hint",
        "aria-hidden": "${hasHint ? \"false\" : \"true\"}"
      },
      "children": [
        {
          "text": "${this.hint}"
        }
      ],
      "classMap": [
        {
          "name": "has-slotted",
          "when": "hasHint"
        }
      ]
    }
  ],
  "parts": [
