      "type": "Boolean",
      "reflect": true,
      "default": "this.hasAttribute(\"checked\")"
    },
    {
      "name": "required",
      "attribute": "required",
      "type": "Boolean",
      "reflect": true,
      "default": "false"
    },
    {
