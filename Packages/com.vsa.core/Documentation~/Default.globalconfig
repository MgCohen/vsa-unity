is_global = true
# BEGIN com.vsa.core: the editor script of the package writes these lines.
# The rules of Umpire.Kernels.Analyzers (UMP0101xx). Each rule has the defaults of its values on its class.
# The package ships this file, and its build props give it to each project that references the package.
# A consumer changes a value in the .umpireconfig file of its block. Severity uses the standard key: dotnet_diagnostic.UMP010101.severity = none
# Keys: umpire.<rule ID>.<key> for one rule, umpire.<key> for all rules that read the key. A rule key wins.
# If a value is not valid, the build reports UMP010001, and that rule does not run.
# In a list, write a comma between the items: a semicolon starts a comment.
# The keys and their defaults:
#   UMP010101.max = 120, UMP010102.max = 40, UMP010103.max = 300: the maximum characters in a line, lines in a method and lines in a file.
#   UMP010104.allow_same_name = true: types with the same name can share a file, for example Module and Module<TSettings>.
#   UMP010105.kind_order = constant, field, constructor, finalizer, property, event, method, nested_type
#   UMP010105.access_order = public, internal, protected_internal, protected, private_protected, private
#   UMP010105.static_first = true: static before instance.

# The disabled severities of the rules of Umpire.Vsa.Analyzers (UMP0102xx). Each rule has the defaults of its values on its class.
# The package ships this file, and its build props give it to each project that references the package.
# A consumer changes a value or a severity in the .umpireconfig file of its block. Keys: umpire.<rule ID>.<key> for one rule.
# If a value is not valid, the build reports UMP010001, and that rule does not run.
# In a list, write a comma between the items: a semicolon starts a comment.
# The keys and their defaults:
#   UMP010201.check_responses = true: true checks the responses too, false checks only the requests.
#   UMP010207.allowed_bases = (empty): the bases that a Domain.Shared type can use, apart from the Domain.Shared projects.
#     Empty: an interface such as IComparable<T> needs a method, and UMP010206 does not permit methods.
#     An app adds its own bases, for example: umpire.UMP010207.allowed_bases = Card.TypeKeys.TypeKey, Card.Entities.IComponent

# Disabled rules: the design is not clear, so they wait for the review in issue #143 before 0.1.0.
# The list is the table "Disabled rules" in docs/architecture-rules.md. A consumer can turn a rule on in the .umpireconfig file of its block.
dotnet_diagnostic.UMP010203.severity = none
dotnet_diagnostic.UMP010205.severity = none
dotnet_diagnostic.UMP010206.severity = none
dotnet_diagnostic.UMP010207.severity = none
# END com.vsa.core
