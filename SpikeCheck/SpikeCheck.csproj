<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the spike outside Unity, with only the references listed here.
    If the spike uses a type from another assembly, the build fails.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>VSA.TestSuite.Spike.Check</AssemblyName>
    <UnityEditor>C:\Program Files\Unity\Hub\Editor\6000.6.6f1\Editor</UnityEditor>
    <UnityManaged>$(UnityEditor)\Data\Managed\UnityEngine</UnityManaged>
    <ScriptAssemblies>$(MSBuildThisFileDirectory)..\Library\ScriptAssemblies</ScriptAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Packages\com.vsa.testsuite\Spike\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NoRefs)' != 'true'">
    <!-- Unity engine modules -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(UnityManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <!-- uGUI package (com.unity.ugui) -->
    <Reference Include="UnityEngine.UI"><HintPath>$(ScriptAssemblies)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <!-- Pipeline package (com.unity.pipeline): CliCommand and CliArg -->
    <Reference Include="Unity.Pipeline.Attributes"><HintPath>$(ScriptAssemblies)\Unity.Pipeline.Attributes.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
