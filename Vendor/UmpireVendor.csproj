<Project Sdk="Microsoft.NET.Sdk">
  <!-- Only for vendor.cs: dotnet publish of this project gives the Umpire packages and their dependencies for Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <UmpireVersion>0.2.0-preview.9</UmpireVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- One Umpire.dll for the whole framework. The other DLLs are its third-party dependencies. -->
    <PackageReference Include="Umpire" Version="$(UmpireVersion)" />
    <!-- The two analyzer DLLs (Roslyn 4.10 build). The kernel analyzer embeds its config reader. -->
    <PackageDownload Include="Umpire.Vsa.Analyzers" Version="[$(UmpireVersion)]" />
  </ItemGroup>
</Project>
